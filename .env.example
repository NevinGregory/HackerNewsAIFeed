# --- Required API keys ---

# ElevenLabs API key for text-to-speech (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Deepgram API key for legacy TTS/STT fallback (https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional: Choose one LLM provider for script generation.
# Gemini is recommended for the free tier.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# --- Advanced Settings ---

# Hacker News API endpoints (no key needed)
HN_TOP_STORIES_URL=https://hacker-news.firebaseio.com/v0/topstories.json
HN_ITEM_URL=https://hacker-news.firebaseio.com/v0/item/{id}.json

# Output directories (relative to project root)
OUTPUT_DIR=videos
CACHE_DIR=cache
ASSETS_DIR=assets

# ElevenLabs voice & model settings
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_MODEL=eleven_turbo_v2_5

# Script generation model
# Options: "gemini" or "openai"
SCRIPT_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-4o-mini